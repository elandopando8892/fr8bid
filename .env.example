# Interfaz: modo «simulado» (Rateware en memoria) o «rateware» (rateware-prod vía /api)
VITE_FR8BID_MODO=simulado
# Solo modo rateware: Supabase Auth de rateware-prod (URL y anon key son públicas)
VITE_RATEWARE_SUPABASE_URL=
VITE_RATEWARE_SUPABASE_ANON_KEY=
# Funciones /api (Vercel, servidor)
RATEWARE_SUPABASE_URL=
RATEWARE_SUPABASE_ANON_KEY=
# Cualquier valor distinto de «si» bloquea toda escritura hacia Rateware real
# (la Mesa y los módulos de Bidware)
FR8BID_ESCRITURAS_REALES=no
# Opcional: el dominio de las ligas para carriers y shippers (por omisión, el de Bidware)
VITE_APP_ORIGIN=
